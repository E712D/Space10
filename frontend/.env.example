# Copier ce fichier en .env.local pour surcharger les valeurs en local.

# true  = données simulées (aucun backend nécessaire)
# false = appels réels vers l'API Django REST
VITE_USE_MOCK=false

# Racine de l'API Django REST (sans barre oblique finale)
# En développement Vite, laisser vide utilise le proxy vers Django.
VITE_API_BASE_URL=
